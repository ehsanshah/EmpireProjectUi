# Vite reads this at build time. The local review UI defaults to Demo.
VITE_CORE_MODE=demo
# I01-B project-only bootstrap is off by default. It requires a same-origin,
# externally configured gateway and real identity/session providers.
VITE_I01B_PROJECT_BOOTSTRAP=disabled
# Do not place credentials or access tokens in VITE_* variables; they are bundled into the browser.
